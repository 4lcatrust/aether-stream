            "type": "grafana-clickhouse-datasource",
            "uid": "aether-clickhouse"
          },
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT CASE WHEN countIf(pipeline_status = 'stale') > 0 THEN 'STALE' WHEN countIf(pipeline_status = 'empty') > 0 THEN 'EMPTY' WHEN countIf(pipeline_status = 'delayed') > 0 THEN 'DELAYED' ELSE 'HEALTHY' END AS status FROM omt.pipeline_health",

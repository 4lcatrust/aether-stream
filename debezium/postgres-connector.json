{
  "name": "aether-postgres-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",

    "database.hostname": "${env:POSTGRES_HOST}",
    "database.port":     "${env:POSTGRES_PORT}",
    "database.user":     "${env:DEBEZIUM_USER}",
    "database.password": "${env:DEBEZIUM_PASSWORD}",
    "database.dbname":   "${env:APP_DB}",

    "topic.prefix":        "${env:DEBEZIUM_TOPIC_PREFIX}",
    "schema.include.list": "${env:DEBEZIUM_SCHEMA_INCLUDE}",
    "table.include.list":  "${env:DEBEZIUM_TABLE_INCLUDE}",

    "plugin.name": "pgoutput",
    "slot.name":   "${env:DEBEZIUM_SLOT}",
    "publication.autocreate.mode": "filtered",

    "tombstones.on.delete": "false",
    "decimal.handling.mode": "string",
    "time.precision.mode": "connect",

    "snapshot.mode": "initial",
    "snapshot.fetch.size": "2000",

    "heartbeat.interval.ms": "10000",
    "include.schema.changes": "false"
  }
}
